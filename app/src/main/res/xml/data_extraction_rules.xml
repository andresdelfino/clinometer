<?xml version="1.0" encoding="utf-8"?>
<!-- Keeps the calibration, in calibration.xml, out of backups and device transfers: it describes
     this phone, its camera bump and its case, and would skew every reading on another one. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="calibration.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="calibration.xml" />
    </device-transfer>
</data-extraction-rules>
